# Dossier marée-type : contient les données de test et les figures générées
phase1_detection/Marée type/

# Fichiers verrou temporaires créés par Excel/Word
~$*

# Préférence locale de langue (générée automatiquement au premier lancement)
config.json

# Environnement Python — inutile sur GitHub, recréé localement par uv sync
__pycache__/
*.pyc
*.pyo
.env
# Environnement virtuel uv (200+ Mo de librairies — recréé automatiquement par uv sync)
.venv/

# Outputs générés Phase 3 (documents Word de test ou générés par l'app — pas du code source)
phase3_rapport/test_output_*.docx
phase3_rapport/*_Rapport.docx

