# Annotations locales de l'observateur — données propres à chaque machine
phase1_detection/annotations/

# Données de travail utilisateur — ne jamais envoyer sur GitHub
data/
*.zip
*.xlsx
*.xls
*.csv

# Exception : les fichiers de règles de correction sont versionnés (c'est du code, pas des données)
